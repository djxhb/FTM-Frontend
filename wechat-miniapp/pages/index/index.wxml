<view class="container">
  <view class="card header">
    <view class="heading">Breast Cancer Risk Calculator</view>
    <view class="hint">Select values to update the estimated risk on your device.</view>
  </view>

  <view class="card result">
    <view class="result-label">Risk of Breast Cancer</view>
    <view class="total">{{riskPercent}}</view>
    <view class="hint">Chart-derived estimate; not for clinical decisions.</view>
  </view>

  <view class="card">
    <view class="section-title">Input Parameters</view>
    <view wx:for="{{fields}}" wx:key="key" class="row">
      <view class="field-title">{{item.title}} <text class="field-key">{{item.key}}</text></view>
      <picker class="picker" mode="selector" range="{{item.labels}}" value="{{item.selectedIndex}}" data-key="{{item.key}}" bindchange="onFieldChange">
        <view class="picker-value">{{item.labels[item.selectedIndex]}} <text class="chevron">⌄</text></view>
      </picker>
    </view>
    <button class="reset" bindtap="onReset">Reset to Defaults</button>
  </view>
</view>
